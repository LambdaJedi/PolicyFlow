@page "/"
@inject PolicyService PolicyService

<PageTitle>PolicyFlow - Dashboard</PageTitle>

<div class="container py-4">
    <h1>PolicyFlow</h1>
    <p class="text-secondary">
        Insurance Policy Management
    </p>

    <div class="row g-3 my-3">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Total Policies</h5>
                    <h2>@Policies.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Active Policies</h5>
                    <h2>@ActivePolicies</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Monthly Premiums</h5>
                    <h2>R @MonthlyPremiums.ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
        <h3 class="mb-0">Policies</h3>

        <a href="/policies/create" class="btn btn-primary">
            + Create Policy
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="policySearch" class="form-label">
                        Search policies
                    </label>

                    <input id="policySearch"
                           type="text"
                           class="form-control"
                           placeholder="Policy number or customer name..."
                           @bind="SearchTerm"
                           @bind:event="oninput" />
                </div>

                <div class="col-md-3">
                    <label for="statusFilter" class="form-label">
                        Filter by status
                    </label>

                    <select id="statusFilter"
                            class="form-select"
                            @bind="SelectedStatus">
                        <option value="All">All statuses</option>
                        @foreach (var status in PolicyStatuses.All)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="typeFilter" class="form-label">
                        Filter by type
                    </label>

                    <select id="typeFilter"
                            class="form-select"
                            @bind="SelectedType">
                        <option value="All">All types</option>
                        @foreach (var type in PolicyTypes.All)
                        {
                            <option value="@type">@PolicyTypes.DisplayName(type)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mt-3">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="ClearFilters">
                    Clear Filters
                </button>

                <span class="text-secondary ms-2">
                    Showing @FilteredPolicies.Count() of @Policies.Count policies
                </span>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover mt-3">
            <thead>
                <tr>
                    <th>Policy Number</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th>Premium</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            Loading policies...
                        </td>
                    </tr>
                }
                else if (!FilteredPolicies.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            No policies match your search or filters.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var policy in FilteredPolicies)
                    {
                        <tr>
                            <td>
                                <a href="@($"/policies/details/{policy.Id}")">
                                    @policy.PolicyNumber
                                </a>
                            </td>
                            <td>@policy.CustomerName</td>
                            <td>@policy.PolicyType</td>
                            <td>R @policy.MonthlyPremium.ToString("N2")</td>
                            <td><StatusBadge Status="@policy.Status" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<InsurancePolicy> Policies = new();
    private bool isLoading = true;

    private string SearchTerm = "";
    private string SelectedStatus = "All";
    private string SelectedType = "All";

    private IEnumerable<InsurancePolicy> FilteredPolicies =>
        Policies
            .Where(p =>
                string.IsNullOrWhiteSpace(SearchTerm) ||
                p.PolicyNumber.Contains(
                    SearchTerm.Trim(),
                    StringComparison.OrdinalIgnoreCase) ||
                p.CustomerName.Contains(
                    SearchTerm.Trim(),
                    StringComparison.OrdinalIgnoreCase))
            .Where(p =>
                SelectedStatus == "All" ||
                p.Status == SelectedStatus)
            .Where(p =>
                SelectedType == "All" ||
                p.PolicyType == SelectedType)
            .OrderByDescending(p => p.Id);

    private int ActivePolicies =>
        Policies.Count(p => p.Status == PolicyStatuses.Active);

    private decimal MonthlyPremiums =>
        Policies
            .Where(p => p.Status == PolicyStatuses.Active)
            .Sum(p => p.MonthlyPremium);

    protected override async Task OnInitializedAsync()
    {
        Policies = await PolicyService.GetAllAsync();
        isLoading = false;
    }

    private void ClearFilters()
    {
        SearchTerm = "";
        SelectedStatus = "All";
        SelectedType = "All";
    }
}
